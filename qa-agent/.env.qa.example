# ─────────────────────────────────────────────────────────────────────────────
# RankedCEO QA Agent — Environment Variables
# Copy to .env.qa and fill in values. NEVER commit .env.qa to the repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Target URL ────────────────────────────────────────────────────────────────
# For PR smoke tests: set to the Vercel preview URL for that PR
# For weekly full run: set to https://qa.rankedceo.com
QA_BASE_URL=https://qa.rankedceo.com

# ── Admin Persona ─────────────────────────────────────────────────────────────
QA_ADMIN_EMAIL=your-admin@example.com
QA_ADMIN_PASSWORD=your-admin-password

# ── Client Persona ────────────────────────────────────────────────────────────
# A valid reviewToken for a QA test client tenant (pre-seeded in `qa` schema)
QA_CLIENT_REVIEW_TOKEN=your-qa-review-token

# ── Supabase ──────────────────────────────────────────────────────────────────
# Use the SAME project as production, but all QA records go to the `qa` schema
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ────────────────────────────────────────────────────────────────────
# Only needed for --mode full (weekly run)
# Set QA_BILLING_MOCK=true to skip real Stripe checkout (PR smoke tests)
STRIPE_SECRET_KEY=sk_test_...
QA_BILLING_MOCK=false

# ── Resend ────────────────────────────────────────────────────────────────────
# Used for:
#   1. Critical halt notification emails
#   2. Email delivery verification in --mode full
RESEND_API_KEY=re_...
QA_ADMIN_EMAIL_NOTIFY=admin@yourdomain.com

# ── GitHub ────────────────────────────────────────────────────────────────────
# Used for:
#   1. Creating `qa-critical-halt` issues on critical halt
#   2. Checking for open `qa-critical-halt` issues (restart gate)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=twinwicksllc/rankedceo-crm-production

# Optional restart gate override:
#   - true  => always enforce gate before run
#   - false => always skip gate (recommended for PR smoke)
#   - unset => enforce for --mode full, skip for --mode smoke
QA_RESTART_GATE=
