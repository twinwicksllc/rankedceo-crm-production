{
  "name": "@rankedceo/qa-agent",
  "version": "0.1.0",
  "description": "Autonomous QA agent for RankedCEO — dual-persona, severity-gated, weekly full lifecycle + PR smoke",
  "private": true,
  "type": "module",
  "scripts": {
    "qa-agent": "tsx src/cli.ts",
    "smoke": "tsx src/cli.ts --scenario scenarios/smoke.yaml",
